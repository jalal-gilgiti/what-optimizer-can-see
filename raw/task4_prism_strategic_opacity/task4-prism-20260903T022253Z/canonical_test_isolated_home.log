CREATE OR REPLACE FUNCTION isListDistinct_outlined_0(delim VARCHAR, list VARCHAR) RETURNS BOOLEAN AS $$
DECLARE
pos INTEGER;

BEGIN
    


pos := ((STRPOS((LTRIM(RTRIM(list)) || delim), delim)::int));
list := ((LTRIM(RTRIM(list)) || delim));
LOOP


IF pos > 0 THEN



IF STRPOS((SUBSTRING(list, pos+1, LENGTH(list))),(LTRIM(RTRIM(LEFT(list,pos))))) <> 0 THEN
RETURN (FALSE);
END IF;


pos := ((STRPOS((SUBSTRING(list, pos+1, LENGTH(list))),delim)::int));
list := ((SUBSTRING(list, pos+1, LENGTH(list))));
CONTINUE;
END IF;
EXIT;
END LOOP;

RETURN (TRUE);

END;$$
LANGUAGE PLPGSQL;
