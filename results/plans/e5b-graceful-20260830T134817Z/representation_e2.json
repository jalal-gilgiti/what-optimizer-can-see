      "source": "def e5b_e2_l100_filter_before(value: int) -> int:\n    import math\n    state = value\n    for index0 in range(10):\n        state = state + index0 + 0\n        state = state - math.floor(state / 2147483648) * 2147483648\n        for index1 in range(10):\n            state = state + index1 + 1\n            state = state - math.floor(state / 2147483648) * 2147483648\n            state = state * 1103515245 + 12345\n            state = state - math.floor(state / 2147483648) * 2147483648\n    return state\n",
